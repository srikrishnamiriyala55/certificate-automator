{
  "name": "certificate-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Local certificate generation and distribution studio",
  "author": "Certificate Studio",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "predev": "node scripts/ensure-electron.mjs && electron-builder install-app-deps && npm run build:electron",
    "test:watch": "vitest",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run test && npm run build:web && npm run build:electron",
    "dist": "npm run build && electron-rebuild -f -w better-sqlite3 && electron-builder --config.npmRebuild=false",
    "postinstall": "node scripts/ensure-electron.mjs && electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "12.2.0",
    "electron-log": "^5.4.1",
    "electron-store": "^10.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "uuid": "^11.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.19",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.certificatestudio.app",
    "productName": "Certificate Studio",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
